# Conexión normal de la app, sujeta a RLS.
DATABASE_URL=postgresql://app_user:CAMBIA_ESTO@localhost:5432/sr_mantenimiento

# Conexión de servicio SOLO para el login (rol con BYPASSRLS, ver src/db/rls.sql).
DATABASE_URL_AUTH_SERVICE=postgresql://app_auth_service:CAMBIA_ESTO@localhost:5432/sr_mantenimiento

# Genera con: openssl rand -base64 32
AUTH_SECRET=CAMBIA_ESTO_POR_ALGO_ALEATORIO_DE_32_BYTES

# Opcionales: credenciales del primer admin que crea el seed.
# Si no se indican, se genera un email por defecto y una contraseña
# aleatoria que se imprime una sola vez en la consola al sembrar.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------
# MODO DE PRUEBAS — desactiva el login para navegar la app sin loguearse.
# SOLO para local. La app se niega a arrancar si esto está activo junto
# a NODE_ENV=production (ver src/lib/modo-pruebas.ts). Bórralo o ponlo
# en false antes de desplegar de verdad.
# ---------------------------------------------------------------------
AUTH_MODO_PRUEBAS=false
MODO_PRUEBAS_USER_ID=

# ---------------------------------------------------------------------
# Almacenamiento de fotos, compatible con S3 (MinIO en el servidor propio).
#
# Sin estas variables la app arranca igual: la subida de fotos responde 503
# y el resto funciona. Es deliberado, para poder desplegar sin almacenamiento.
#
# El endpoint es interno de Docker (http, sin s): el trafico no sale del
# servidor. Usa una clave de acceso propia de la aplicacion, NUNCA las de
# root de MinIO — si se filtran, que no tengan permiso sobre todo.
# ---------------------------------------------------------------------
S3_ENDPOINT=http://nombre-interno-minio:9000
S3_BUCKET=mantenimiento-fotos
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ---------------------------------------------------------------------
# TEXTOS LEGALES — identidad de la empresa que explota la aplicación.
#
# De aquí salen /legal/privacidad, /legal/cookies, /legal/aviso-legal y el
# pie de protección de datos de cada acta. Lo que falte aparece marcado como
# «[pendiente]» en la página pública, y Configuración avisa a administración.
#
# NO se inventa ningún dato: un aviso legal con un CIF equivocado es peor que
# no tenerlo. Rellénalos antes de que la aplicación salga de pruebas.
#
# Al vender la aplicación a otro instalador, esto es lo único que cambia:
# cada cliente es un despliegue propio con su propia identidad.
# ---------------------------------------------------------------------
LEGAL_RESPONSABLE_NOMBRE=SR Energía
LEGAL_RESPONSABLE_CIF=
LEGAL_RESPONSABLE_DIRECCION=
LEGAL_RESPONSABLE_EMAIL=
LEGAL_RESPONSABLE_TELEFONO=

# Solo si se ha designado Delegado de Protección de Datos. La mayoría de las
# pymes no están obligadas; déjalo vacío si no es el caso.
LEGAL_DPD_CONTACTO=

# Quien desarrolla y mantiene la aplicación: el encargado del tratamiento.
LEGAL_ENCARGADO_NOMBRE=Grupo LMB
LEGAL_ENCARGADO_EMAIL=admin@nexus-sales.eu

# Dónde se alojan los datos. Es un subencargado y hay que declararlo.
LEGAL_ALOJAMIENTO=Hetzner Online GmbH
LEGAL_ALOJAMIENTO_UBICACION=Alemania (Unión Europea)

# Dirección pública de la aplicación. Se imprime en el acta, que se lee en
# papel: una ruta relativa no llevaría a ninguna parte.
APP_URL=https://mantenimiento.nexus-sales.eu
